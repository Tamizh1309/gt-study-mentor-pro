# ══════════════════════════════════════════════════════════════
#  GT Study Mentor Pro — Production & Development Configuration
# ══════════════════════════════════════════════════════════════

# Server Port
PORT=3000

# Environment Mode: development | staging | production
NODE_ENV=production

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUESTS_PER_WINDOW=120

# Cache TTL Configuration (in seconds)
CACHE_TTL_COMPANIES=180
CACHE_TTL_MAP_STATES=300

# Optional: Cloud AI Provider for GT JARVIS (Google Gemini / OpenAI)
# If left blank, JARVIS operates seamlessly using the built-in Local High-Yield CSE Intelligence!
JARVIS_API_KEY=your_gemini_or_cloud_api_key_here
JARVIS_MODEL=gemini-1.5-flash
JARVIS_PROVIDER=gemini # options: gemini | local

# Backward compatibility for legacy endpoints
GEMINI_API_KEY=

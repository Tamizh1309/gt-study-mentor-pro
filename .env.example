# ══════════════════════════════════════════════════════════════
#  GT Study Mentor Pro — JARVIS Autonomous Architecture Config
# ══════════════════════════════════════════════════════════════

# Server Port & Runtime
PORT=3000
NODE_ENV=production

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUESTS_PER_WINDOW=120

# Cache TTL Configuration (in seconds)
CACHE_TTL_COMPANIES=180
CACHE_TTL_MAP_STATES=300

# ──────────────────────────────────────────────────────────────
# GT JARVIS Multi-Model Router & Gateway Configuration
# Blueprint Sections 4, 5, 8, 9, 10, 29
# ──────────────────────────────────────────────────────────────

# Active Gateway Provider: freellmapi | omnirouter | deepseek | kimi | glm | offline_cse
JARVIS_PROVIDER=freellmapi

# 1. FreeLLMAPI — Local AI Gateway (Section 4)
# Used for low-latency experimentation and local development
FREELLMAPI_URL=http://127.0.0.1:3001/v1
FREELLMAPI_KEY=local-token
FREELLMAPI_MODEL=auto:balanced

# 2. OmniRouter — Multi-Model Aggregator (Section 5)
# OpenAI-compatible multi-model routing layer
OMNIROUTER_BASE_URL=https://omnirouter.li/v1
OMNIROUTER_API_KEY=your_omnirouter_api_key_here
OMNIROUTER_MODEL=auto:router

# 3. DeepSeek Provider — Coding, Algorithm, DSA & SQL (Section 10)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 4. Kimi Provider — Long Context, Resume & Knowledge Synthesis (Section 9)
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=your_kimi_api_key_here
KIMI_MODEL=moonshot-v1-32k

# 5. GLM Provider — Technical Reasoning & Complex Explanations (Section 8)
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4

# 6. Legacy / Direct Gemini Key (Backward Compatibility)
JARVIS_API_KEY=
JARVIS_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────
# OpenClaw Automation Gateway (Blueprint Section 7 & 23)
# Read-only external channel dispatcher (Slack, Discord, Telegram, Webhook)
# ──────────────────────────────────────────────────────────────
OPENCLAW_WEBHOOK_URL=
OPENCLAW_TOKEN=
